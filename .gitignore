# ==========================================
.ipynb_checkpoints
*-checkpoint.py

# ==========================================
# 5. Data, Weights & Artifacts (Tránh push file nặng)
# ==========================================
# Bỏ qua dữ liệu thô & tiền xử lý
data/raw/
data/processed/

# Cho phép Git theo dõi thư mục notebook phân tích dữ liệu
!data/explore_data/
!data/explore_data/**
!data/explore_data/**/*.csv

# Bỏ qua định dạng file dữ liệu lớn & weights
*.csv
*.pt
*.pth
*.ckpt
*.onnx
*.bin
*.h5
*.pkl
*.npy
*.npz
*.zip
*.tar.gz

# Thư mục logs, checkpoints & outputs thực nghiệm
checkpoints/
saved_models/
logs/
wandb/
runs/
results/
outputs/

# Giữ lại file .gitkeep để duy trì cấu trúc thư mục rỗng
!.gitkeep

